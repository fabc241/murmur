{
  "name": "murmur",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint",
    "android": "expo run:android",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@qvac/asr-ggml-android-arm64": "0.10.0",
    "@qvac/asr-ggml-ios": "0.10.0",
    "@qvac/fabric-android-arm64": "0.22.0",
    "@qvac/fabric-ios": "0.22.0",
    "@qvac/sdk": "^0.22.0",
    "bare-rpc": "^1.3.8",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.24",
    "expo-keep-awake": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-bare-kit": "^0.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/ios/",
      "/android/"
    ]
  }
}
