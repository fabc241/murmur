{
  "expo": {
    "name": "Murmur",
    "slug": "murmur",
    "scheme": "murmur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F5F1",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#121413"
      }
    },
    "ios": {
      "bundleIdentifier": "com.fabianacordella.murmur",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      },
      "appleTeamId": "5CYK686SKS"
    },
    "android": {
      "package": "com.fabianacordella.murmur",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Murmur records clinical visits so they can be transcribed and documented on this device. Audio never leaves your iPhone.",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "@qvac/sdk/expo-plugin",
        {
          "installMissingPrebuilds": true
        }
      ],
      "expo-asset",
      "./plugins/with-space-safe-bundle-phase",
      "./plugins/with-scene-lifecycle"
    ]
  }
}
